# Public value embedded in the browser bundle at build time
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key

# Server-only secrets
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
RESEND_API_KEY=replace_with_resend_api_key

# Contact delivery and verification policy
CONTACT_FROM_EMAIL=notifications@plana.lk
CONTACT_TO_EMAIL=info@plana.lk
TURNSTILE_ALLOWED_HOSTNAMES=plana.lk,www.plana.lk,localhost,127.0.0.1
TURNSTILE_EXPECTED_ACTION=plana_contact
